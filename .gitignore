# --- Model artifacts ---
# price_classifier.pkl IS committed (~16 MB) so the app deploys/runs out-of-the-box.
# Any other .pkl stays out of git.
models/*.pkl
!models/price_classifier.pkl

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# --- Virtual envs ---
.venv/
venv/
env/

# --- Streamlit ---
.streamlit/secrets.toml

# --- OS / editor ---
.DS_Store
.idea/
.vscode/
